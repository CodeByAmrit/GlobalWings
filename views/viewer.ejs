<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= aircraft.name %> | GlobalWings Viewer</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS (via PostCSS/CLI) -->
    <link rel="stylesheet" href="/css/index.css?v=1.2" />
    <!-- Reusing global theme -->
    <link rel="stylesheet" href="/css/viewer.css?v=1.2" />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
  </head>

  <body class="bg-sky-deep font-inter text-sky-main overflow-x-hidden">
    <!-- Navigation -->
    <nav class="glass-nav sticky top-0 py-4 px-6 mb-0">
      <div class="container mx-auto flex justify-between items-center">
        <a class="no-underline text-white" href="/">
          <span class="fw-bold font-outfit text-xl"
            ><i class="bi bi-airplane-engines mr-2"></i>GlobalWings</span
          >
        </a>
        <div class="flex gap-3">
          <a href="/" class="btn-nav py-2 px-4 rounded-lg bg-sky-accent/10 border border-sky-accent/30 text-sm hover:bg-sky-accent/20 transition-all no-underline text-white">Back to Fleet</a>
          <button class="btn-nav-primary py-2 px-6 rounded-lg bg-sky-accent text-white font-semibold text-sm hover:bg-sky-accent/80 transition-all border-none">Connect System</button>
        </div>
      </div>
    </nav>

    <main class="grid grid-cols-1 md:grid-cols-[1fr_400px] h-[calc(100vh-80px)] overflow-hidden">
      <!-- 3D Scene -->
      <div class="relative bg-black/20 flex flex-col items-center justify-center border-r border-sky-glass-border/30">
        <model-viewer
          src="<%= aircraft.model_path %>"
          alt="<%= aircraft.name %> 3D Model"
          auto-rotate
          camera-controls
          camera-orbit="45deg 75deg auto"
          shadow-intensity="2"
          environment-image="neutral"
          exposure="1"
          ar
          ar-modes="webxr scene-viewer quick-look"
          class="w-full h-full"
        >
          <div slot="progress-bar" class="progress-bar hide">
            <div class="update-bar"></div>
          </div>
        </model-viewer>

        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 p-2 bg-black/40 backdrop-blur-md rounded-2xl border border-white/10">
          <button class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-sky-accent/40 transition-all" title="Fullscreen">
            <i class="bi bi-fullscreen"></i>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-sky-accent/40 transition-all" title="Play Record">
            <i class="bi bi-camera-reels"></i>
          </button>
          <button class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-sky-accent/40 transition-all" title="Diagnostics">
            <i class="bi bi-cpu"></i>
          </button>
        </div>
      </div>

      <!-- Data Sidebar -->
      <div class="bg-sky-deep/50 overflow-y-auto py-12 px-8 custom-scrollbar">
        <div class="sidebar-content">
          <div class="mb-12">
            <span class="inline-block bg-sky-accent/20 border border-sky-accent/40 rounded-full px-4 py-1 text-[0.7rem] font-bold tracking-widest text-sky-cyan uppercase mb-3"
              ><%= aircraft.type %></span
            >
            <h1 class="text-5xl font-black font-syne mb-2 text-white"><%= aircraft.name %></h1>
            <p class="text-sky-dim text-xl"><%= aircraft.model %></p>
          </div>

          <div class="mb-12">
            <h4 class="text-xs uppercase tracking-[3px] font-bold text-sky-dim/60 mb-6 border-b border-white/5 pb-2">Technical Specifications</h4>

            <div class="space-y-4">
                <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/5">
                  <div class="w-12 h-12 flex items-center justify-center bg-sky-accent/20 rounded-xl text-sky-accent text-xl"><i class="bi bi-speedometer"></i></div>
                  <div>
                    <span class="block text-[0.65rem] uppercase tracking-wider text-sky-dim font-bold">Maximum Speed</span>
                    <span class="text-xl font-bold text-white"><%= aircraft.speed %> <small class="text-xs opacity-50 font-normal">km/h</small></span>
                  </div>
                </div>
                
                <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/5">
                  <div class="w-12 h-12 flex items-center justify-center bg-sky-accent/20 rounded-xl text-sky-accent text-xl"><i class="bi bi-compass"></i></div>
                  <div>
                    <span class="block text-[0.65rem] uppercase tracking-wider text-sky-dim font-bold">Combat Range</span>
                    <span class="text-xl font-bold text-white"><%= aircraft._range %> <small class="text-xs opacity-50 font-normal">km</small></span>
                  </div>
                </div>
                
                <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/5">
                  <div class="w-12 h-12 flex items-center justify-center bg-sky-accent/20 rounded-xl text-sky-accent text-xl"><i class="bi bi-fuel-pump-diesel"></i></div>
                  <div>
                    <span class="block text-[0.65rem] uppercase tracking-wider text-sky-dim font-bold">Fuel Capacity</span>
                    <span class="text-xl font-bold text-white"><%= aircraft.fuel_capacity %> <small class="text-xs opacity-50 font-normal">L</small></span>
                  </div>
                </div>
                
                <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/5">
                  <div class="w-12 h-12 flex items-center justify-center bg-sky-accent/20 rounded-xl text-sky-accent text-xl"><i class="bi bi-hammer"></i></div>
                  <div>
                    <span class="block text-[0.65rem] uppercase tracking-wider text-sky-dim font-bold">Empty weight</span>
                    <span class="text-xl font-bold text-white"><%= aircraft.weight %> <small class="text-xs opacity-50 font-normal">kg</small></span>
                  </div>
                </div>
            </div>
          </div>

          <div class="mb-12">
            <h4 class="text-xs uppercase tracking-[3px] font-bold text-sky-dim/60 mb-6 border-b border-white/5 pb-2">Origin & Manufacturer</h4>
            <div class="p-6 bg-white/5 backdrop-blur-md rounded-2xl border border-white/5">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 flex items-center justify-center bg-sky-dim/10 rounded-full text-2xl">
                  <i class="bi bi-globe-americas"></i>
                </div>
                <div>
                  <span class="block text-[0.65rem] uppercase tracking-wider text-sky-dim font-bold">Registry</span>
                  <span class="text-lg font-bold text-white"><%= aircraft.country %></span>
                </div>
              </div>
              <p class="text-sm text-sky-dim/80 leading-relaxed">
                Propulsion and structural integrity verified for deployment in
                all high-altitude environments.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <button id="downloadBtn" class="flex-1 py-4 bg-sky-accent text-white rounded-2xl font-bold shadow-lg shadow-sky-accent/20 hover:bg-sky-accent/80 transition-all border-none">
              Download telemetry
            </button>
            <button id="shareBtn" class="w-14 h-14 flex items-center justify-center bg-white/5 border border-white/10 rounded-2xl text-xl hover:bg-white/10 transition-all">
              <i class="bi bi-share"></i>
            </button>
          </div>
        </div>
      </div>
    </main>

    <script type="module" src="/js/model-viewer.min.js"></script>
    <script src="/js/viewer.js?v=1.2"></script>
  </body>
</html>
