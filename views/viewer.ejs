<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= aircraft.name %> | GlobalWings Viewer</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/logos/logos.svg">
    <link rel="stylesheet" href="/css/index.css?v=1.2"> <!-- Reusing global theme -->
    <link rel="stylesheet" href="/css/viewer.css?v=1.2">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-main text-white">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg glass-nav fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="fw-bold outfit-font"><i class="bi bi-airplane-engines me-2"></i>GlobalWings</span>
            </a>
            <div class="d-flex gap-3">
                <a href="/" class="btn-nav">Back to Fleet</a>
                <button class="btn-nav-primary">Connect System</button>
            </div>
        </div>
    </nav>

    <main class="viewer-layout">
        <!-- 3D Scene -->
        <div class="viewer-column scene-container">
            <model-viewer 
                src="<%= aircraft.model_path %>" 
                alt="<%= aircraft.name %> 3D Model" 
                auto-rotate 
                camera-controls
                camera-orbit="45deg 75deg auto" 
                shadow-intensity="2" 
                environment-image="neutral"
                exposure="1"
                ar 
                ar-modes="webxr scene-viewer quick-look" 
                class="viewer-3d-full">
                
                <div slot="progress-bar" class="progress-bar hide">
                    <div class="update-bar"></div>
                </div>
            </model-viewer>
            
            <div class="scene-controls">
                <button class="btn-control" title="Fullscreen"><i class="bi bi-fullscreen"></i></button>
                <button class="btn-control" title="Play Record"><i class="bi bi-camera-reels"></i></button>
                <button class="btn-control" title="Diagnostics"><i class="bi bi-cpu"></i></button>
            </div>
        </div>

        <!-- Data Sidebar -->
        <div class="viewer-column info-sidebar py-5 px-4">
            <div class="sidebar-content">
                <div class="header-reveal mb-5">
                    <span class="badge-type mb-2 d-inline-block"><%= aircraft.type %></span>
                    <h1 class="display-4 fw-bold mb-1"><%= aircraft.name %></h1>
                    <p class="text-secondary fs-5"><%= aircraft.model %></p>
                </div>

                <div class="specs-grid mb-5">
                    <h4 class="sidebar-section-title mb-4">Technical Specifications</h4>
                    
                    <div class="spec-card">
                        <div class="spec-icon"><i class="bi bi-speedometer"></i></div>
                        <div class="spec-info">
                            <span class="spec-label">Maximum Speed</span>
                            <span class="spec-value highlight-blue"><%= aircraft.speed %> <small>km/h</small></span>
                        </div>
                    </div>
                    
                    <div class="spec-card">
                        <div class="spec-icon"><i class="bi bi-compass"></i></div>
                        <div class="spec-info">
                            <span class="spec-label">Combat Range</span>
                            <span class="spec-value highlight-blue"><%= aircraft._range %> <small>km</small></span>
                        </div>
                    </div>
                    
                    <div class="spec-card">
                        <div class="spec-icon"><i class="bi bi-fuel-pump-diesel"></i></div>
                        <div class="spec-info">
                            <span class="spec-label">Fuel Capacity</span>
                            <span class="spec-value highlight-blue"><%= aircraft.fuel_capacity %> <small>L</small></span>
                        </div>
                    </div>
                    
                    <div class="spec-card">
                        <div class="spec-icon"><i class="bi bi-hammer"></i></div>
                        <div class="spec-info">
                            <span class="spec-label">Empty weight</span>
                            <span class="spec-value highlight-blue"><%= aircraft.weight %> <small>kg</small></span>
                        </div>
                    </div>
                </div>

                <div class="mission-section mb-5">
                    <h4 class="sidebar-section-title mb-3">Origin & Manufacturer</h4>
                    <div class="info-box-glass">
                        <div class="d-flex align-items-center mb-3">
                            <div class="country-avatar me-3">
                                <i class="bi bi-globe-americas"></i>
                            </div>
                            <div>
                                <span class="d-block text-secondary small uppercase">Registry</span>
                                <span class="fw-bold"><%= aircraft.country %></span>
                            </div>
                        </div>
                        <p class="small text-secondary mb-0">
                            Propulsion and structural integrity verified for deployment in all high-altitude environments.
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button id="downloadBtn" class="btn-primary-glow flex-grow-1">Download telemetry</button>
                    <button id="shareBtn" class="btn-secondary-glass"><i class="bi bi-share"></i></button>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/js/model-viewer.min.js"></script>
    <script src="/js/viewer.js?v=1.2"></script>
</body>

</html>