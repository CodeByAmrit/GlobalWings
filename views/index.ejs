<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GlobalWings - Aircraft Database</title>
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/index.css">
    <link rel="stylesheet" href="css/scroll.css">
</head>

<body class="bg-dark text-white customDarkBgLight">
    <div class="container height100">

        <div class="card-body position-relative">
            <div class="flex scaleUp mt-3 positionSet">
                <!-- <a class="navbar-brand z-3" href="/">
                    <img src="/logos/gw_logo.svg" width="120px" height="120px" alt="GlobalWings">
                </a> -->
                <p class="text-center m-0 p-0 fw-bold fontlarge transition-text">
                    Global&nbsp;Wings
                </p>

            </div>
            <!-- Change Model with Dynamic EJS -->
            <model-viewer src="/models/2.glb" alt="3D model of an aircraft" auto-rotate camera-orbit="90deg 90deg auto"
                shadow-intensity="1.5" ar ar-modes="webxr scene-viewer quick-look" camera-target="20m 20m 0m"
                field-of-view="70deg" touch-action="pan-y" class="w-100 height100">
            </model-viewer>
        </div>
    </div>
    <div class="container mt-5">
        <h1 class="text-center mb-4">GlobalWings Aircraft</h1>

        <!-- Search Form -->
        <form id="searchForm" class="d-flex mb-4">
            <input class="form-control" type="search" id="searchInput" placeholder="Search aircraft by name..."
                aria-label="Search">
            <button class="btn btn-outline-success mx-3" type="submit">Search</button>
            <a class="btn btn-primary" href="/add.html">Add</a>
        </form>

        <!-- Aircraft Cards -->
        <div class="row" id="aircraftCards">
            <% aircraft.forEach(aircraft=> { %>
                <div class="col-md-4 mb-4">
                    <div class="card card-hover text-white opa50">

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= aircraft.aircraft_name %>
                            </h5>
                            <p class="card-text">Model: <%= aircraft.aircraft_model %>
                            </p>
                            <p class="card-text">Type: <%= aircraft.type_name %>
                            </p>
                            <a href="/viewer/<%= aircraft.aircraft_id %>" class="btn btn-primary">Open</a>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>


    <script src="js/index.js"></script>
    <script src="js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/js/model-viewer.min.js"></script>
</body>

</html>